{
  "name": "academic-research-assistant",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "pack:check": "npm run pack:check --workspaces --if-present && npm run pack:check:resources",
    "check": "npm run validate:skills && npm run validate:profiles && npm run validate:disciplines && npm run validate:distribution && npm run typecheck && npm test && npm run build && npm run example:check && npm run pack:check",
    "example:check": "node examples/read-document.mjs",
    "validate:distribution": "node --test scripts/distribution-validation.test.mjs && node scripts/validate-distribution.mjs",
    "pack:check:resources": "node scripts/check-distribution.mjs",
    "validate:skills": "node --test scripts/validate-skills.test.mjs && node scripts/validate-skills.mjs",
    "validate:profiles": "node --test scripts/validate-profiles.test.mjs && node scripts/validate-profiles.mjs",
    "validate:disciplines": "node --test scripts/validate-disciplines.test.mjs && node scripts/validate-disciplines.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "license": "Apache-2.0"
}
