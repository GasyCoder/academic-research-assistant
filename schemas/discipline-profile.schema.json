{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GasyCoder/academic-research-assistant/main/schemas/discipline-profile.schema.json",
  "title": "Discipline profile",
  "description": "Optional project-maintained generic guidance, not official requirements or evidence of scientific validity. Format version is independent of research profiles and repository releases.",
  "type": "object",
  "additionalProperties": false,
  "required": ["disciplineProfileVersion", "id", "label", "description"],
  "properties": {
    "disciplineProfileVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "label": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "aliases": { "$ref": "#/$defs/textList" },
    "writing": { "$ref": "#/$defs/textList" },
    "structure": { "$ref": "#/$defs/textList" },
    "methodology": { "$ref": "#/$defs/textList" },
    "evidence": { "$ref": "#/$defs/textList" },
    "citations": { "$ref": "#/$defs/textList" },
    "review": { "$ref": "#/$defs/textList" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    }
  }
}
